DATABASE_URL="postgresql://homestock:homestock@localhost:5432/homestock_ai?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Hosted demo mode
# Keep these enabled for public/demo deployments until production auth exists.
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"

# Grocery commerce provider
# Local, QA, and hosted demo deployments should remain on mock mode.
GROCERY_PROVIDER="mock"

# Future Swiggy Builders Club / Instamart MCP placeholders.
# These are intentionally optional and unused in mock mode.
SWIGGY_BUILDERS_ENABLED="false"
SWIGGY_BUILDERS_CLIENT_ID=""
SWIGGY_BUILDERS_CLIENT_SECRET=""
SWIGGY_BUILDERS_REDIRECT_URI=""

# Auth.js (Phase 1+ readiness — optional; only required for non-demo deployments).
# Demo deployments (DEMO_MODE=true) ignore these and continue to use actorId
# query switching. See docs/auth-readiness.md.
AUTH_SECRET=""
AUTH_URL=""

# Resend (recommended for production). Create an API key at resend.com,
# verify a sending domain, then set both vars below.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM=""

# Legacy / fallback: Nodemailer SMTP connection string. Used only when Resend
# is not configured. Example: smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=""
EMAIL_FROM=""

# Local-only smoke flag. When set to "true" AND NODE_ENV is not "production",
# Auth.js logs the magic-link sign-in URL to the server stdout instead of
# sending email. AUTH_SECRET is the only other requirement for /sign-in to
# render the form. Used by docs/non-demo-auth-smoke.md.
# MUST remain unset in any deployed environment. If set in production, dev-log
# is hard-disabled and /sign-in surfaces an "unsafe configuration" warning.
AUTH_DEV_LOG_MAGIC_LINK=""
